# Copia questo file in .env e compila i valori prima di avviare l'app.
# Il file .env NON va mai committato nel repository (è già in .gitignore).

# Credenziali pannello admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiami_con_password_sicura

# Chiave segreta per firmare i cookie di sessione.
# Genera un valore casuale con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sostituisci_con_chiave_casuale_di_almeno_32_caratteri

# Ambiente: "development" (default) oppure "production"
# In production i cookie vengono impostati come secure (richiede HTTPS).
ENVIRONMENT=development

# Domini frontend autorizzati (solo in production).
# Lascia vuoto in sviluppo locale.
# Esempio: CORS_ORIGINS=https://mia-pizzeria.it,https://www.mia-pizzeria.it
CORS_ORIGINS=
